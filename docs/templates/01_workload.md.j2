| {{ v.quantity }} | {{ v.paper }} | {% if v.ours > 1e6 %}{{ (v.ours/1e9)|n(2) }}B{% elif v.ours < 1 %}+{{ (v.ours*100)|n(0) }}%{% else %}{{ v.ours|n(0) }}{% endif %} |
